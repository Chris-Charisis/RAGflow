MINIO_ACCESS_KEY=fysalida
MINIO_SECRET_KEY=kx12kx12

RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password

POSTGRES_PASSWORD=example

# ----------------------------------------------------------------------------
# v2.0 — chunking (text_chunker)
# ----------------------------------------------------------------------------
# Strategy: tokens (default, token-aware) | words | sentences | recursive
CHUNK_STRATEGY=tokens
# Size/overlap are in TOKENS for the 'tokens' strategy, words otherwise.
CHUNK_SIZE=400
CHUNK_OVERLAP=60
# Strip pre-introduction / post-references boilerplate (academic heuristic).
# Set false for general (non-paper) documents.
STRIP_BOILERPLATE=true

# ----------------------------------------------------------------------------
# v2.0 — rag_api (retrieval + generation)
# ----------------------------------------------------------------------------

# Must match the ingestion side:
COLLECTION=recursive_with_overlap
EMBED_MODEL=mxbai-embed-large:335m
OLLAMA_BASE_URL=http://ollama:11434

# Hybrid retrieval: alpha 1.0=vector, 0.0=keyword(BM25), 0.5=balanced
RETRIEVAL_ALPHA=0.5
RETRIEVAL_TOP_K=10

# Reranking (optional, off by default).
# RERANK_PROVIDER: flashrank (default) | cross_encoder | cohere
RERANK_ENABLED=false
RERANK_PROVIDER=flashrank
RERANK_TOP_N=4
# COHERE_API_KEY=

# LLM provider: ollama (default) | openai | gemini | anthropic
LLM_PROVIDER=ollama
# LLM_MODEL=                 # leave blank for the provider default (anthropic -> claude-opus-4-8)
# Only the selected provider's key is needed:
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
